# Install at /etc/rivet/api.env, root:root mode 0600.
# The unit fixes loopback, port, root path and agent backend.
RIVET_AGENT_SOCKET=/run/ovpn-agent/agent.sock
RIVET_AGENT_UID=REPLACE_WITH_AGENT_UID
RIVET_CLIENT_CONFIG_PATH=/opt/rivet/client.ovpn
RIVET_AUTH_PROVIDER=entra
AZURE_ENTRAID_TENANT_ID=REPLACE_WITH_TENANT_UUID
AZURE_ENTRAID_APP_CLIENT_ID=REPLACE_WITH_API_APP_UUID
AZURE_ENTRAID_USER_ROLE=device_user
AZURE_ENTRAID_ADMIN_ROLE=sysadmin
AZURE_ENTRAID_SERVICE_ADMIN_ROLE=ServiceAdmin
RIVET_AUTH_AUTO_REGISTER_USERS=true
# Legacy AZURE_ENTRAID_AUTO_REGISTER_USERS remains supported; if both are set,
# they must agree. Restart the API after changing authentication settings.
RIVET_VPN_EVENTS=0
RIVET_VPN_RECONCILE=0
# Optional secrets: use protected systemd credentials or a private env file.
# SQLALCHEMY_DATABASE_URI=
# AZURE_STORAGE_CONNECTION_STRING=
# RIVET_STORAGE_PROVIDER=local
