# Install at /etc/rivet/agent.env, root:ovpn-runtime mode 0640.
# Paths refer to preprovisioned private state. Use exact numeric peer IDs.
RIVET_AGENT_CONFIG=/var/lib/ovpn-agent/projection/server.conf
RIVET_AGENT_PKI=/var/lib/ovpn-agent/pki
RIVET_AGENT_CCD=/var/lib/ovpn-agent/ccd
RIVET_AGENT_JOURNAL=/var/lib/ovpn-agent/journal
RIVET_AGENT_PROJECTION=/var/lib/ovpn-agent/projection
RIVET_AGENT_OWNERSHIP=/var/lib/ovpn-agent/config/ownership.json
RIVET_AGENT_SOCKET=/run/ovpn-agent/agent.sock
RIVET_AGENT_EVENT_SOCKET=/run/ovpn-events/events.sock
RIVET_MANAGEMENT_SOCKET=/run/openvpn/management.sock
RIVET_MANAGEMENT_UID=0
RIVET_MANAGEMENT_GID=REPLACE_WITH_RUNTIME_GID
RIVET_OPENVPN_UID=REPLACE_WITH_OPENVPN_UID
RIVET_API_UID=REPLACE_WITH_API_UID
RIVET_AGENT_EASYRSA=/usr/share/easy-rsa/easyrsa
RIVET_FIREWALL_DEVICE=tun0
# Allocate a protocol before enabling routes; do not use a fixture default.
# RIVET_AGENT_ROUTE_PROTOCOL=
# Start observation-only. Enable families after state and firewall review.
RIVET_AGENT_MUTATIONS=
