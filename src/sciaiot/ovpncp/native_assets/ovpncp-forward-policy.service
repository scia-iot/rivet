[Unit]
Description=Scoped VPN forwarding guard before OpenVPN listener
After=network-online.target
Before=ovpncp-openvpn.service

[Service]
Type=oneshot
User=ovpn-agent
Group=ovpn-runtime
SupplementaryGroups=ovpn-control
WorkingDirectory=/var/lib/ovpn-agent
EnvironmentFile=/etc/ovpncp/agent.env
ExecStart=/usr/local/lib/ovpncp/agent-venv/bin/ovpncp-native-firewall
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/ovpncp

[Install]
WantedBy=multi-user.target
