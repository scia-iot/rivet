# Install at /etc/ovpncp/agent.env, root:ovpn-runtime mode 0640.
# Paths refer to preprovisioned private state. Use exact numeric peer IDs.
OVPNCP_AGENT_CONFIG=/var/lib/ovpn-agent/projection/server.conf
OVPNCP_AGENT_PKI=/var/lib/ovpn-agent/pki
OVPNCP_AGENT_CCD=/var/lib/ovpn-agent/ccd
OVPNCP_AGENT_JOURNAL=/var/lib/ovpn-agent/journal
OVPNCP_AGENT_PROJECTION=/var/lib/ovpn-agent/projection
OVPNCP_AGENT_OWNERSHIP=/var/lib/ovpn-agent/config/ownership.json
OVPNCP_AGENT_SOCKET=/run/ovpn-agent/agent.sock
OVPNCP_AGENT_EVENT_SOCKET=/run/ovpn-events/events.sock
OVPNCP_MANAGEMENT_SOCKET=/run/openvpn/management.sock
OVPNCP_MANAGEMENT_UID=0
OVPNCP_MANAGEMENT_GID=REPLACE_WITH_RUNTIME_GID
OVPNCP_OPENVPN_UID=REPLACE_WITH_OPENVPN_UID
OVPNCP_API_UID=REPLACE_WITH_API_UID
OVPNCP_AGENT_EASYRSA=/usr/share/easy-rsa/easyrsa
OVPNCP_FIREWALL_DEVICE=tun0
# Allocate a protocol before enabling routes; do not use a fixture default.
# OVPNCP_AGENT_ROUTE_PROTOCOL=
# Start observation-only. Enable families after state and firewall review.
OVPNCP_AGENT_MUTATIONS=
