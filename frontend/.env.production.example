VITE_AUTH_PROVIDER=entra
# Production builds must keep browser authentication enabled.
VITE_AUTH_DISABLED=false

# Register the deployed HTTPS origin as an Entra SPA redirect URI.
VITE_ENTRA_TENANT_ID=<tenant-uuid>
VITE_ENTRA_CLIENT_ID=<spa-application-client-uuid>
VITE_ENTRA_API_SCOPE=api://<api-application-client-uuid>/access_as_user

# Nginx owns the same-origin /api boundary and strips this prefix before
# forwarding requests to loopback-only FastAPI.
VITE_API_BASE_URL=/api
