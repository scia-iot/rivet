VITE_AUTH_PROVIDER=entra
# Browser-facing Entra application registration
# Set true only for explicit local UI development without authentication.
VITE_AUTH_DISABLED=false
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=api://<api-application-id>/access_as_user

# Vite proxies /api to FastAPI during local development.
VITE_API_BASE_URL=/api
