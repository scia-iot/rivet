# Copy to deploy/container.env (ignored). Build only needs this first section.
# Set the registry host plus optional namespace for your deployment.
# Also supports Docker Hub, ACR, and other OCI-compatible registries.
OVPNCP_REGISTRY=
OVPNCP_IMAGE_TAG=dev
# Build platform for the deployment target; the reference images use AMD64.
OVPNCP_PLATFORM=linux/amd64

# Public UI settings are supplied at container startup, never at image build.
OVPNCP_UI_ENTRA_TENANT_ID=
OVPNCP_UI_ENTRA_CLIENT_ID=
OVPNCP_UI_ENTRA_API_SCOPE=

# Deployment stage only: replace with verified registry/repository@sha256:... .
OVPNCP_OPENVPN_IMAGE=
OVPNCP_AGENT_IMAGE=
OVPNCP_API_IMAGE=
OVPNCP_WEB_IMAGE=
OVPNCP_STATE_ROOT=/srv/ovpncp
# Keep loopback until the private gateway/backend firewall is reviewed.
OVPNCP_HTTP_BIND=127.0.0.1
OVPNCP_HTTP_PORT=8080
AZURE_ENTRAID_TENANT_ID=
AZURE_ENTRAID_APP_CLIENT_ID=
AZURE_ENTRAID_USER_ROLE=device_user
AZURE_ENTRAID_ADMIN_ROLE=sysadmin
AZURE_ENTRAID_SERVICE_ADMIN_ROLE=ServiceAdmin
AZURE_ENTRAID_AUTO_REGISTER_USERS=true
# Required operator allocation; no production route protocol is assumed.
OVPNCP_AGENT_ROUTE_PROTOCOL=
# Start observation-only. Enable each family after reviewed bootstrap/testing.
OVPNCP_AGENT_MUTATIONS=
OVPNCP_VPN_EVENTS=0
OVPNCP_VPN_RECONCILE=0
