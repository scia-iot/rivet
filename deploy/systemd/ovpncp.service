[Unit]
Description=OpenVPN Control Panel API
Wants=network-online.target
After=network-online.target openvpn.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ovpncp
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=OVPNCP_ROOT_PATH=/api
EnvironmentFile=/etc/ovpncp/ovpncp.env
ExecStart=/opt/ovpncp/venv/bin/ovpncp
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/openvpn /opt/ovpncp

[Install]
WantedBy=multi-user.target
