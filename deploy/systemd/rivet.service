[Unit]
Description=Rivet API
Wants=network-online.target
Wants=rivet-agent.service
After=network-online.target rivet-agent.service

[Service]
Type=simple
User=ovpn-api
Group=ovpn-control
WorkingDirectory=/opt/rivet
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=RIVET_ROOT_PATH=/api
Environment=RIVET_VPN_BACKEND=agent
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/rivet/api.env
ExecStart=/usr/local/lib/rivet/api-venv/bin/rivet
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/rivet
InaccessiblePaths=-/var/lib/ovpn-agent -/run/openvpn -/run/ovpn-events -/etc/openvpn

[Install]
WantedBy=multi-user.target
