# Render only the four placeholders documented in the deployment runbook.
# Install the rendered file inside Nginx's http context.

map $uri $ovpncp_cache_control {
    default "no-store";
    ~^/assets/ "public, max-age=31536000, immutable";
    ~^/favicon\.svg$ "public, max-age=3600";
}

upstream ovpncp_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${OVPNCP_HOSTNAME};
    access_log off;
    error_log /dev/null crit;

    return 308 https://${OVPNCP_HOSTNAME}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${OVPNCP_HOSTNAME};

    root ${OVPNCP_FRONTEND_ROOT};
    index index.html;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;

    ssl_certificate ${OVPNCP_TLS_CERTIFICATE};
    ssl_certificate_key ${OVPNCP_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ovpncp_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Cache-Control $ovpncp_cache_control always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://login.microsoftonline.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://login.microsoftonline.com; frame-src https://login.microsoftonline.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy
        "camera=(), geolocation=(), microphone=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security
        "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location = /api {
        proxy_pass http://ovpncp_api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Server;
    }

    location ^~ /api/ {
        proxy_pass http://ovpncp_api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_hide_header Server;
    }

    location = /index.html {
        try_files $uri =404;
    }

    location = /favicon.svg {
        try_files $uri =404;
        access_log off;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        access_log off;
    }

    location / {
        try_files $uri /index.html;
    }
}
