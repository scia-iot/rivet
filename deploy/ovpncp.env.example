# Required together. None of these values is a client secret.
AZURE_ENTRAID_TENANT_ID=<tenant-id>
AZURE_ENTRAID_APP_CLIENT_ID=<api-application-client-id>
AZURE_ENTRAID_USER_ROLE=user
AZURE_ENTRAID_ADMIN_ROLE=admin
AZURE_ENTRAID_SERVICE_ADMIN_ROLE=ServiceAdmin

# Optional database override. The default is SQLite under /opt/ovpncp.
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host/database

# Optional Azure Blob Storage integration. Treat this value as a secret.
# AZURE_STORAGE_CONNECTION_STRING=<storage-connection-string>

# HOST, PORT, and OVPNCP_ROOT_PATH are intentionally fixed by the systemd
# unit. The application itself trusts forwarded caller addresses only from
# 127.0.0.1 so the local Nginx boundary remains authoritative.
