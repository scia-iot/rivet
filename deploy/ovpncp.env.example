# Required together. None of these values is a client secret.
AZURE_ENTRAID_TENANT_ID=<tenant-id>
AZURE_ENTRAID_APP_CLIENT_ID=<api-application-client-id>
AZURE_ENTRAID_USER_ROLE=device_user
AZURE_ENTRAID_ADMIN_ROLE=sysadmin
AZURE_ENTRAID_SERVICE_ADMIN_ROLE=ServiceAdmin

# Optional strict boolean; automatic delegated-user registration defaults on.
AZURE_ENTRAID_AUTO_REGISTER_USERS=true

# Optional generated shared profile path override. The default is shown.
# OVPNCP_CLIENT_CONFIG_PATH=/opt/ovpncp/client.ovpn

# Optional database override. The default is SQLite under /opt/ovpncp.
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host/database

# Optional Azure Blob Storage integration. Treat this value as a secret.
# AZURE_STORAGE_CONNECTION_STRING=<storage-connection-string>

# HOST, PORT, and OVPNCP_ROOT_PATH are intentionally fixed by the systemd
# unit. The application itself trusts forwarded caller addresses only from
# 127.0.0.1 so the local Nginx boundary remains authoritative.

# Phase 2 transition; an actual agent service is delivered in later phases.
OVPNCP_VPN_BACKEND=host
OVPNCP_AGENT_SOCKET=/run/ovpn-agent/agent.sock
# Required only when selecting agent; use the configured agent process UID.
# OVPNCP_AGENT_UID=

# Phase 3 optional disposable shadow verification: OVPNCP_VPN_BACKEND=shadow
# Requires explicit OVPNCP_AGENT_UID and protected UDS; see docs/vpn-agent.md.
